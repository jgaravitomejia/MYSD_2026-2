{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ventas Pytar-Shop",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id_venta", "fecha_venta", "metodo_pago", "estado_venta", "medio_entrega", "cliente", "ubicacion_entrega", "detalles", "factura"],
    "additionalProperties": false,
    "properties": {
      "id_venta": {
        "type": "integer",
        "minimum": 1
      },
      "fecha_venta": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "metodo_pago": {
        "type": "string",
        "enum": ["Efectivo", "Transferencia", "Contraentrega"]
      },
      "estado_venta": {
        "type": "string",
        "enum": ["Pendiente", "Completada", "Cancelada"]
      },
      "medio_entrega": {
        "type": "string",
        "enum": ["Paqueteria", "Domicilio"]
      },
      "observaciones": {
        "type": "string",
        "maxLength": 200
      },
      "cliente": {
        "type": "object",
        "required": ["id_cliente", "nombre", "telefono"],
        "additionalProperties": false,
        "properties": {
          "id_cliente": {
            "type": "integer",
            "minimum": 1
          },
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "telefono": {
            "type": "string",
            "minLength": 7,
            "maxLength": 15
          },
          "correo": {
            "type": "string",
            "pattern": ".+@.+\\..+"
          }
        }
      },
      "ubicacion_entrega": {
        "type": "object",
        "required": ["calle", "ciudad", "departamento"],
        "additionalProperties": false,
        "properties": {
          "calle": {
            "type": "string",
            "minLength": 1
          },
          "barrio": {
            "type": "string"
          },
          "ciudad": {
            "type": "string",
            "minLength": 1
          },
          "departamento": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "detalles": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["producto", "tipo", "categoria", "cantidad", "precio_venta", "descuento"],
          "additionalProperties": false,
          "properties": {
            "producto": {
              "type": "string",
              "minLength": 1
            },
            "tipo": {
              "type": "string",
              "enum": ["Ropa", "Calzado", "Accesorio"]
            },
            "categoria": {
              "type": "string",
              "enum": [
                "Camisa", "Blusa", "Pantalon", "Falda", "Vestido", "Chaqueta", "Abrigo", "Sudadera", "Shorts", "Jean",
                "Zapatilla", "Botin", "Bota", "Sandalia", "Plataforma", "Moccasin", "Deportivo", "Chancla",
                "Bolso", "Cartera", "Mochila", "Joyeria", "Pulsera", "Aretes", "Anillo", "Cinturon", "Gorra", "Gafas", "Reloj", "Billetera"
              ]
            },
            "talla": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": ["XS", "S", "M", "L", "XL", "XXL", "T2", "T4", "T6", "T8", "T10", "T12", "T14"]
                },
                {
                  "type": "integer",
                  "minimum": 18,
                  "maximum": 45
                }
              ]
            },
            "genero": {
              "type": "string",
              "enum": ["Mujer", "Hombre", "Unisex", "Niño", "Niña"]
            },
            "cantidad": {
              "type": "integer",
              "minimum": 1
            },
            "precio_venta": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "descuento": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "factura": {
        "type": "object",
        "required": ["id_factura", "estado_factura"],
        "additionalProperties": false,
        "properties": {
          "id_factura": {
            "type": "integer",
            "minimum": 1
          },
          "estado_factura": {
            "type": "string",
            "enum": ["Emitida", "Pagada", "Anulada"]
          },
          "numero_guia": {
            "type": "string"
          }
        }
      }
    }
  }
}